pipeline {
  agent {
    label 'netbox'
  }

  options {
    disableConcurrentBuilds()
    timestamps()
  }

  triggers {
    cron('H 3 * * *')   // daily around 3am
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Run maintenance prune') {
      environment {
        SMB_CREDS = credentials('jenkins-artifacts-smb')
      }
      steps {
        sh '''#!/bin/bash
          set -euo pipefail

        # SMB target details
        SMB_SERVER="dc-01.intra.wonderingpacket.com"
        SMB_SHARE="jenkins-artifacts"
        SMB_BASE="netbox"

        # Run maintenance script against the SMB share
        python3 scripts/maintenance_smb.py \
          --server "$SMB_SERVER" \
          --share "$SMB_SHARE" \
          --base "$SMB_BASE" \
          --keep 200 \
          --username "$SMB_CREDS_USR" \
          --password "$SMB_CREDS_PSW"
        '''
      }
    }
  }

  post {
    always {
      cleanWs()
    }
  }
}
