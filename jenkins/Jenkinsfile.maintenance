pipeline {
  agent {
    label 'netbox'
  }

  options {
    disableConcurrentBuilds()
    timestamps()
  }

  triggers {
    cron('H 3 * * *')   // daily around 3am
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Run maintenance prune') {
      steps {
        sh '''#!/bin/bash
          set -euo pipefail

          python3 --version
          python3 scripts/maintenance_smb.py --root "$ROOT" --keep 2
        '''
      }
    }
  }

  post {
    always {
      cleanWs()
    }
  }
}
